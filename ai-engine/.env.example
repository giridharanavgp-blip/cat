# Google Gemini API key (free tier) - get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq API key (alternative free LLM provider) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Which LLM provider to use: "gemini" or "groq"
LLM_PROVIDER=gemini

# Supabase (used to persist analysis/report results directly from the AI engine)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base

# Directory to store generated PDFs before upload
PDF_OUTPUT_DIR=./generated_reports

# CORS - comma separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
